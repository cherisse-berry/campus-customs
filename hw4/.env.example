# Campus Customs settings. This file has placeholders only and is safe to commit.
#
# To set up: run `python setup_env.py --api-key` in backend/. It copies this file to
# hw4/.env, fills in a random SESSION_SECRET and asks for your API key (typing is hidden).
# Or copy this file to .env yourself and fill in the values. Never commit .env.

# Long random string used to sign login cookies (setup_env.py fills this in)
SESSION_SECRET=

# Anthropic API key for the chat assistant, from https://platform.claude.com/settings/keys
# (setup_env.py --api-key asks for it)
ANTHROPIC_API_KEY=

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Optional: Claude model for the chat assistant (default: claude-opus-5-5)
# CHAT_MODEL=claude-opus-5-5

# Optional: a different Claude API endpoint (default: https://api.anthropic.com).
# ANTHROPIC_BASE_URL is ignored on purpose, since tools like Claude Code set it for themselves.
# CHAT_ANTHROPIC_BASE_URL=

# Optional: where the database and product images are (default: hw4/data)
# CAMPUS_DATA_DIR=/path/to/data

# Optional: where the chatbot audit trail is written (default: hw4/output/audit_trail.json)
# CHAT_AUDIT_LOG=/path/to/audit_trail.json

# Optional: website addresses allowed to call the API (default: the Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: hide PydanticAI's startup banner in the server log
PYDANTIC_AI_NO_BANNER=1
