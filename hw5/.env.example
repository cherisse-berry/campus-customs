# Campus Customs agent settings (Homework 5). This file has placeholders only and is safe to commit.
#
# To set up: copy this file to hw5/.env and fill in the value. Never commit .env:
# the repository's .gitignore keeps it out of GitHub.

# Portkey API key. All five agents use gpt-6-luna through Portkey with this key.
PORTKEY_API_KEY=

# Optional: which Portkey endpoint the agents use (default: responses).
#   responses = OpenAI Responses API (/v1/responses); tools work with reasoning on.
#   chat      = chat completions (/v1/chat/completions) with reasoning turned off.
# OPENAI_ENDPOINT=responses

# Optional: reasoning effort on the responses endpoint: none, minimal, low (default), medium, high.
# OPENAI_REASONING_EFFORT=low
