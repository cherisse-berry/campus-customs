{
  "name": "equitas-ux-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Black-box, multistakeholder browser testing harness for the EQUITAS Intelligence website. Runs on the founder's own computer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check-manifest": "node src/check-manifest.js",
    "login": "node src/login.js",
    "probe-plan": "node src/probe-plan.js",
    "scenario": "node src/run-scenario.js",
    "batch": "node src/run-batch.js",
    "report": "node src/report.js",
    "matrix": "node src/matrix.js",
    "selftest": "node selftest/run-selftest.js && node selftest/public-audit-selftest.js && node selftest/integrity-selftest.js",
    "purge-evidence": "node src/purge-evidence.js",
    "auth-diagnose": "node src/auth-diagnose.js",
    "public-audit": "node src/public-audit.js",
    "investigate": "node src/investigate-finding.js",
    "validate-reports": "node src/validate-reports.js",
    "selftest:core": "node selftest/run-selftest.js",
    "selftest:public": "node selftest/public-audit-selftest.js",
    "validate-keyboard": "node src/validate-keyboard-detector.js",
    "reconcile": "node src/reconcile.js",
    "analyze-blocked": "node src/analyze-blocked.js",
    "evidence-snapshot": "node src/evidence-integrity.js",
    "verify-evidence": "node src/evidence-integrity.js",
    "selftest:integrity": "node selftest/integrity-selftest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.63.0",
    "zod": "^4.0.0"
  }
}
